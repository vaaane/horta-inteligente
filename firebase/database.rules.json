{
  "rules": {
    "teste": {
      ".read": true,
      ".write": true
    },

    "clima": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren(['temperatura', 'umidadeAr', 'chuvaAgoraMm', 'chanceChuva6h', 'et0', 'horaPrevisao'])",
      "temperatura": {
        ".validate": "newData.isNumber()"
      },
      "umidadeAr": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
      },
      "chuvaAgoraMm": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "chanceChuva6h": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
      },
      "et0": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "horaPrevisao": {
        ".validate": "newData.isString()"
      },
      "atualizadoEm": {
        ".validate": "newData.isNumber() && newData.val() <= now"
      },
      "$outro": {
        ".validate": false
      }
    },

    "horta": {
      ".read": true,

      "estado": {
        ".write": "auth != null && auth.uid === 'gj7r2D4JvTYr9GTnkmEc40ZqWRU2'",
        ".validate": "newData.hasChildren(['umidade', 'umidadeBruta', 'bomba', 'ts'])",
        "umidade": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "umidadeBruta": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4095"
        },
        "bomba": {
          ".validate": "newData.isBoolean()"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "modoTeste": {
          ".validate": "newData.isBoolean()"
        },
        "regaDesde": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "hora": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 23"
        },
        "cotaHoje": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "litrosCota": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "decisao": {
          ".validate": "newData.isString() && newData.val().matches(/^(regando|solo_ok|adiada_chuva|horario_quente|cota_atingida|solo_critico|sem_previsao|pausa_seguranca|manual_ligada|manual_desligada)$/)"
        },
        "motivo": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "$outro": {
          ".validate": false
        }
      },

      "leituras": {
        ".write": "auth != null && auth.uid === 'gj7r2D4JvTYr9GTnkmEc40ZqWRU2'",
        ".indexOn": ["ts"],
        "$leituraId": {
          ".validate": "newData.hasChildren(['umidade', 'bomba', 'ts'])",
          "umidade": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "bomba": {
            ".validate": "newData.isBoolean()"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$outro": {
            ".validate": false
          }
        }
      },

      "decisoes": {
        ".write": "auth != null && auth.uid === 'gj7r2D4JvTYr9GTnkmEc40ZqWRU2'",
        ".indexOn": ["ts"],
        "$decisaoId": {
          ".validate": "newData.hasChildren(['decisao', 'motivo', 'umidade', 'ts'])",
          "decisao": {
            ".validate": "newData.isString() && newData.val().matches(/^(regando|solo_ok|adiada_chuva|horario_quente|cota_atingida|solo_critico|sem_previsao|pausa_seguranca|manual_ligada|manual_desligada)$/)"
          },
          "motivo": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "umidade": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "chanceChuva": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$outro": {
            ".validate": false
          }
        }
      },

      "regas": {
        ".write": "auth != null && auth.uid === 'gj7r2D4JvTYr9GTnkmEc40ZqWRU2'",
        ".indexOn": ["fim"],
        "$regaId": {
          ".validate": "newData.hasChildren(['fim', 'segundos', 'litros', 'motivo'])",
          "fim": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "inicio": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "segundos": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
          },
          "litros": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "motivo": {
            ".validate": "newData.isString() && newData.val().matches(/^(regando|solo_ok|adiada_chuva|horario_quente|cota_atingida|solo_critico|sem_previsao|pausa_seguranca|manual_ligada|manual_desligada)$/)"
          },
          "$outro": {
            ".validate": false
          }
        }
      },

      "agua": {
        "dias": {
          "$dia": {
            ".write": "auth != null && auth.uid === 'gj7r2D4JvTYr9GTnkmEc40ZqWRU2'",
            ".validate": "$dia.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['litros', 'segundos', 'regas'])",
            "litros": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "segundos": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "regas": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "et0": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "atualizadoEm": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now"
            },
            "$outro": {
              ".validate": false
            }
          }
        },
        "$outro": {
          ".validate": false
        }
      },

      "config": {
        "inicioMedicao": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$outro": {
          ".validate": false
        }
      },

      "comandos": {
        ".write": true,
        ".validate": "newData.hasChildren(['modo', 'bombaManual'])",
        "modo": {
          ".validate": "newData.isString() && (newData.val() === 'auto' || newData.val() === 'manual')"
        },
        "bombaManual": {
          ".validate": "newData.isBoolean()"
        },
        "manualDesde": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "atualizadoEm": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "zerarCotaEm": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "simularHora": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= -1 && newData.val() <= 23"
        },
        "simularChuva": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && ((newData.val() >= 0 && newData.val() <= 100) || newData.val() === -1)"
        },
        "$outro": {
          ".validate": false
        }
      }
    }
  }
}
