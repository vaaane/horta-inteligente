{
  "rules": {
    "teste": {
      ".read": true,
      ".write": true
    },

    "clima": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren(['temperatura', 'umidadeAr', 'chuvaAgoraMm', 'chanceChuva6h', 'et0', 'horaPrevisao'])",
      "temperatura": {
        ".validate": "newData.isNumber()"
      },
      "umidadeAr": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
      },
      "chuvaAgoraMm": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "chanceChuva6h": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
      },
      "et0": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "horaPrevisao": {
        ".validate": "newData.isString()"
      },
      "atualizadoEm": {
        ".validate": "newData.isNumber() && newData.val() <= now"
      },
      "$outro": {
        ".validate": false
      }
    },

    "horta": {
      ".read": true,

      "estado": {
        ".write": "auth != null && auth.uid === 'UID_DO_ESP32'",
        ".validate": "newData.hasChildren(['umidade', 'umidadeBruta', 'bomba', 'ts'])",
        "umidade": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "umidadeBruta": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4095"
        },
        "bomba": {
          ".validate": "newData.isBoolean()"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "decisao": {
          ".validate": "newData.isString() && newData.val().matches(/^(regando|solo_ok|adiada_chuva|solo_critico|sem_previsao|pausa_seguranca|manual_ligada|manual_desligada)$/)"
        },
        "motivo": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "$outro": {
          ".validate": false
        }
      },

      "leituras": {
        ".write": "auth != null && auth.uid === 'UID_DO_ESP32'",
        ".indexOn": ["ts"],
        "$leituraId": {
          ".validate": "newData.hasChildren(['umidade', 'bomba', 'ts'])",
          "umidade": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "bomba": {
            ".validate": "newData.isBoolean()"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$outro": {
            ".validate": false
          }
        }
      },

      "decisoes": {
        ".write": "auth != null && auth.uid === 'UID_DO_ESP32'",
        ".indexOn": ["ts"],
        "$decisaoId": {
          ".validate": "newData.hasChildren(['decisao', 'motivo', 'umidade', 'ts'])",
          "decisao": {
            ".validate": "newData.isString() && newData.val().matches(/^(regando|solo_ok|adiada_chuva|solo_critico|sem_previsao|pausa_seguranca|manual_ligada|manual_desligada)$/)"
          },
          "motivo": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "umidade": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "chanceChuva": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$outro": {
            ".validate": false
          }
        }
      },

      "comandos": {
        ".write": true,
        ".validate": "newData.hasChildren(['modo', 'bombaManual'])",
        "modo": {
          ".validate": "newData.isString() && (newData.val() === 'auto' || newData.val() === 'manual')"
        },
        "bombaManual": {
          ".validate": "newData.isBoolean()"
        },
        "manualDesde": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "atualizadoEm": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$outro": {
          ".validate": false
        }
      }
    }
  }
}
